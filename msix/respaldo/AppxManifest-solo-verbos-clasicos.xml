<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 rescap">

  <Identity Name="ia21.MiauPlayer"
            Publisher="CN=99EC47F4-46C8-451A-8D0C-554779C4B800"
            Version="1.7.25.0"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Miau Player</DisplayName>
    <PublisherDisplayName>ia21</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es" />
    <Resource Language="en" />
    <Resource Language="pt" />
  </Resources>

  <Applications>
    <Application Id="MiauPlayer" Executable="MiauPlayer.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MiauPlayer"
        Description="Reproductor de audio y video / Audio and video player"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
          <uap3:Extension Category="windows.fileTypeAssociation">
            <uap3:FileTypeAssociation Name="miauaudio">
              <uap:DisplayName>Audio (MiauPlayer)</uap:DisplayName>
              <uap:Logo>Assets\FileIcon.png</uap:Logo>
              <uap:SupportedFileTypes>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.mp2</uap:FileType>
              <uap:FileType>.mp1</uap:FileType>
              <uap:FileType>.aac</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.m4b</uap:FileType>
              <uap:FileType>.flac</uap:FileType>
              <uap:FileType>.ogg</uap:FileType>
              <uap:FileType>.oga</uap:FileType>
              <uap:FileType>.opus</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.aif</uap:FileType>
              <uap:FileType>.aiff</uap:FileType>
              <uap:FileType>.aifc</uap:FileType>
              <uap:FileType>.ape</uap:FileType>
              <uap:FileType>.tta</uap:FileType>
              <uap:FileType>.wv</uap:FileType>
              <uap:FileType>.mpc</uap:FileType>
              <uap:FileType>.wma</uap:FileType>
              <uap:FileType>.ac3</uap:FileType>
              <uap:FileType>.eac3</uap:FileType>
              <uap:FileType>.dts</uap:FileType>
              <uap:FileType>.mka</uap:FileType>
              <uap:FileType>.caf</uap:FileType>
              <uap:FileType>.dsf</uap:FileType>
              <uap:FileType>.dff</uap:FileType>
              <uap:FileType>.amr</uap:FileType>
              <uap:FileType>.au</uap:FileType>
              <uap:FileType>.w64</uap:FileType>
              <uap:FileType>.wave</uap:FileType>
              </uap:SupportedFileTypes>
              <uap2:SupportedVerbs>
                <uap3:Verb Id="open" Parameters="&quot;%1&quot;" MultiSelectModel="Player">Abrir con MiauPlayer</uap3:Verb>
                <uap3:Verb Id="MiauAdd" Parameters="/add &quot;%1&quot;" MultiSelectModel="Document">Añadir a la lista de MiauPlayer</uap3:Verb>
              </uap2:SupportedVerbs>
            </uap3:FileTypeAssociation>
          </uap3:Extension>
          <uap3:Extension Category="windows.fileTypeAssociation">
            <uap3:FileTypeAssociation Name="miauvideo">
              <uap:DisplayName>Video (MiauPlayer)</uap:DisplayName>
              <uap:Logo>Assets\FileIcon.png</uap:Logo>
              <uap:SupportedFileTypes>
              <uap:FileType>.mp4</uap:FileType>
              <uap:FileType>.mov</uap:FileType>
              <uap:FileType>.mkv</uap:FileType>
              <uap:FileType>.wmv</uap:FileType>
              <uap:FileType>.asf</uap:FileType>
              <uap:FileType>.avi</uap:FileType>
              <uap:FileType>.webm</uap:FileType>
              <uap:FileType>.mpg</uap:FileType>
              <uap:FileType>.mpeg</uap:FileType>
              <uap:FileType>.m4v</uap:FileType>
              <uap:FileType>.flv</uap:FileType>
              <uap:FileType>.3gp</uap:FileType>
              <uap:FileType>.ogv</uap:FileType>
              <uap:FileType>.vob</uap:FileType>
              <uap:FileType>.m2ts</uap:FileType>
              <uap:FileType>.mts</uap:FileType>
              </uap:SupportedFileTypes>
              <uap2:SupportedVerbs>
                <uap3:Verb Id="open" Parameters="&quot;%1&quot;" MultiSelectModel="Player">Abrir con MiauPlayer</uap3:Verb>
                <uap3:Verb Id="MiauAdd" Parameters="/add &quot;%1&quot;" MultiSelectModel="Document">Añadir a la lista de MiauPlayer</uap3:Verb>
              </uap2:SupportedVerbs>
            </uap3:FileTypeAssociation>
          </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
